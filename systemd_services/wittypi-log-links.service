[Unit]
Description=Create WittyPi log symlinks in BeeCam data directory
After=local-fs.target beecam-init-data.service
Requires=beecam-init-data.service
Before=wittypi.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '\
  mkdir -p /home/pi/data/logs && \
  chown pi:pi /home/pi/data/logs && \
  [ "$(readlink /home/pi/wittypi/wittyPi.log 2>/dev/null)" = "/home/pi/data/logs/wittyPi.log" ]  || { rm -f /home/pi/wittypi/wittyPi.log;  ln -s /home/pi/data/logs/wittyPi.log  /home/pi/wittypi/wittyPi.log; } && \
  [ "$(readlink /home/pi/wittypi/schedule.log 2>/dev/null)" = "/home/pi/data/logs/schedule.log" ] || { rm -f /home/pi/wittypi/schedule.log; ln -s /home/pi/data/logs/schedule.log /home/pi/wittypi/schedule.log; }'

[Install]
WantedBy=multi-user.target
