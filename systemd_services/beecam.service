[Unit]
Description=BeeCam headless capture service
# Start after the system has reached the normal multi-user state.
# This does NOT mean "after Witty Pi finished everything";
# it only controls normal systemd ordering.
After=multi-user.target beecam-init-data.service
Requires=beecam-init-data.service

# Disable start-rate limiting so repeated crash/restart cycles do not
# permanently stop restart attempts.
StartLimitIntervalSec=0


[Service]
# The service runs as one long-lived foreground process.
Type=simple

# Run as the pi user so file paths, permissions, and environment are predictable.
User=pi
Group=pi

# Set the working directory for relative paths used by the script.
WorkingDirectory=/home/pi/beecam/camera

# Main command that starts the capture script.
ExecStart=/usr/bin/python3 /home/pi/beecam/camera/beecam_capture_final.py --config /data/configs/camera_config_final.ini

# Restart the service if the script exits unexpectedly or crashes.
# It will NOT restart after an intentional:
#   sudo systemctl stop beecam.service
# and it will NOT interfere with normal system shutdown.
Restart=always

# Wait 5 seconds before trying to restart after an unexpected exit.
RestartSec=5

# Send stdout/stderr to the systemd journal so logs can be viewed with:
#   journalctl -u beecam.service -f
StandardOutput=journal
StandardError=journal

# When stopping the service, give it up to 10 seconds to exit cleanly
# before systemd escalates termination.
TimeoutStopSec=10


[Install]
# This is the normal target for regular boot-time services.
# If you are starting the service from Witty Pi's afterStartup.sh instead,
# you may choose NOT to enable this service.
WantedBy=multi-user.target
